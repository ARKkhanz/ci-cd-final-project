{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "ci-cd-final-project"
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app": "ci-cd-final-project"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "ci-cd-final-project"
            }
          },
          "spec": {
            "containers": [
              {
                "name": "counter",
                "image": "image-registry.openshift-image-registry.svc:5000/sn-labs-amarson212/ci-cd-final-project:latest",
                "imagePullPolicy": "Always",
                "ports": [
                  {
                    "containerPort": 8000
                  }
                ],
                "readinessProbe": {
                  "httpGet": {
                    "path": "/health",
                    "port": 8000
                  },
                  "initialDelaySeconds": 5,
                  "periodSeconds": 5
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "ci-cd-final-project"
      },
      "spec": {
        "selector": {
          "app": "ci-cd-final-project"
        },
        "ports": [
          {
            "name": "http",
            "port": 8000,
            "targetPort": 8000
          }
        ]
      }
    },
    {
      "apiVersion": "route.openshift.io/v1",
      "kind": "Route",
      "metadata": {
        "name": "ci-cd-final-project"
      },
      "spec": {
        "to": {
          "kind": "Service",
          "name": "ci-cd-final-project"
        },
        "port": {
          "targetPort": "http"
        }
      }
    }
  ]
}
